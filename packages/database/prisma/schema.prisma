// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// USERS & AUTHENTICATION
// ============================================================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

/**
 * How a user proved their second factor at enrollment time.
 * TOTP = authenticator app (recommended, no phone required).
 * SMS / EMAIL = fallbacks; both are weaker (SIM-swap / inbox takeover).
 */
enum TwoFactorMethod {
  TOTP
  SMS
  EMAIL
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  email       String     @unique
  displayName String?    @map("display_name")
  // Nullable so a 3rd-party-only account can exist without a local password.
  passwordHash String?   @map("password_hash")
  mustChangePassword Boolean @default(false) @map("must_change_password")
  phone       String?
  status      UserStatus @default(ACTIVE)
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  // Set when the address proved reachable (signup link clicked, or the
  // account was created by an admin who delivered credentials by email).
  // Signup blocks sign-in until this is set.
  emailVerifiedAt DateTime? @map("email_verified_at")

  // ── Two-factor authentication (foundation: columns only, flow comes next) ──
  twoFactorEnabled     Boolean          @default(false) @map("two_factor_enabled")
  twoFactorMethod      TwoFactorMethod? @map("two_factor_method")
  // Pre-shared TOTP secret. MUST be encrypted at rest before any enrollment
  // ships (app-level encryption via Prisma field extensions or a KMS-backed
  // accessor) — never returned to the client after enrollment.
  twoFactorSecret      String?          @map("two_factor_secret")
  twoFactorConfirmedAt DateTime?        @map("two_factor_confirmed_at")

  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  // Relations
  profile              UserProfile?
  organizationMembers  OrganizationMember[]
  auditLogs            AuditLog[]
  sessions             Session[]
  recoveryCodes        UserRecoveryCode[]
  passwordResetTokens  PasswordResetToken[]
  emailOtpCodes        EmailOtpCode[]
  emailVerificationTokens EmailVerificationToken[]

  @@map("users")
  @@index([email])
  @@index([status])
}

/**
 * Single-use password reset links. Only the SHA-256 of the token is stored,
 * so a database leak never hands out live reset links; `usedAt` plus a short
 * expiry make every link one-shot.
 */
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
  @@index([userId])
}

/**
 * Single-use signup verification links — same shape as the reset token:
 * SHA-256 of the token at rest, one-shot, short expiry. Sign-in stays closed
 * for the account until one of these is redeemed.
 */
model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
  @@index([userId])
}

/** What a 6-digit emailed code is for. */
enum EmailOtpPurpose {
  TWO_FACTOR_ENROL
  TWO_FACTOR_LOGIN
}

/**
 * One-time codes emailed by the app (2FA enrolment and sign-in). High-entropy
 * for short codes, so SHA-256 is enough; single-use via `usedAt`, short expiry
 * via `expiresAt`.
 */
model EmailOtpCode {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  purpose   EmailOtpPurpose
  codeHash  String          @map("code_hash")
  expiresAt DateTime        @map("expires_at")
  usedAt    DateTime?       @map("used_at")
  createdAt DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_otp_codes")
  @@index([userId, purpose])
}

/**
 * One-time 2FA backup codes. Stored hashed (high-entropy codes, SHA-256) and
 * marked `usedAt` on redemption so each code works exactly once.
 */
model UserRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_recovery_codes")
  @@index([userId])
}

model UserProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  avatarUrl String?  @map("avatar_url")
  bio       String?
  timezone  String?
  locale    String   @default("en")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
  @@index([userId])
}

model Session {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  token          String   @unique
  organizationId String?  @map("organization_id") @db.Uuid
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@map("sessions")
  @@index([userId])
  @@index([token])
  @@index([organizationId])
  @@index([expiresAt])
}

// ============================================================================
// ORGANIZATIONS
// ============================================================================

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrganizationType {
  INDIVIDUAL        // Sole proprietor, individual business owner
  CORPORATION       // Registered corporation/company
  PARTNERSHIP       // Business partnership
  LIMITED_LIABILITY // LLC/Limited liability company
  NON_PROFIT        // Non-profit organization
  GOVERNMENT        // Government agency
  EDUCATIONAL       // Educational institution
  OTHER             // Other business types
}

// Product kind — decides which role templates are seeded on org creation.
// Distinct from OrganizationType (legal form). Nullable for legacy orgs.
enum OrganizationKind {
  LANDLORD              // Self-managed landlord workspace
  PROPERTY_MANAGEMENT   // Company operating properties for owners
  MAINTENANCE_COMPANY   // Maintenance/service business
  MARKETING_AGENT       // House-marketing individual: markets homes, hands tenants off to landlord/PM
}

model Organization {
  id             String             @id @default(uuid()) @db.Uuid
  name           String
  slug           String             @unique
  type           OrganizationType   @default(CORPORATION)
  kind           OrganizationKind?  @map("kind")
  status         OrganizationStatus @default(ACTIVE)
  
  // Business details
  legalName      String?            @map("legal_name")
  taxId          String?            @map("tax_id")
  registrationNumber String?        @map("registration_number")
  
  // Contact information
  email          String?
  phone          String?
  website        String?
  
  // Address
  addressLine1   String?            @map("address_line1")
  addressLine2   String?            @map("address_line2")
  city           String?
  state          String?
  postalCode     String?            @map("postal_code")
  country        String?
  
  // Hierarchy
  parentId       String?            @map("parent_id") @db.Uuid
  parent         Organization?      @relation("OrganizationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subsidiaries   Organization[]     @relation("OrganizationHierarchy")
  
  // Settings
  settings       Json?
  
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  // Relations
  members           OrganizationMember[]
  roles             Role[]
  resourceRelationships ResourceRelationship[]
  auditLogs         AuditLog[]
  locations         OrganizationLocation[]
  sessions          Session[]

  @@map("organizations")
  @@index([slug])
  @@index([status])
  @@index([type])
  @@index([kind])
  @@index([parentId])
  @@index([taxId])
}

model OrganizationLocation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  type           String   // HEADQUARTERS, BRANCH, WAREHOUSE, OFFICE, etc.
  
  // Location details
  addressLine1   String   @map("address_line1")
  addressLine2   String?  @map("address_line2")
  city           String
  state          String?
  postalCode     String?  @map("postal_code")
  country        String?
  
  // Contact
  phone          String?
  email          String?
  
  // Operational
  isPrimary      Boolean  @default(false) @map("is_primary")
  isActive       Boolean  @default(true) @map("is_active")
  
  // Geographic
  latitude       Float?
  longitude      Float?
  
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_locations")
  @@index([organizationId])
  @@index([type])
  @@index([isPrimary])
  @@index([isActive])
}

// ============================================================================
// ORGANIZATION MEMBERSHIPS
// ============================================================================

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles        OrganizationMemberRole[]

  @@unique([organizationId, userId])
  @@map("organization_members")
  @@index([organizationId])
  @@index([userId])
  @@index([status])
}

// ============================================================================
// ROLES
// ============================================================================

model Role {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  name           String
  slug           String
  description    String?
  isSystem       Boolean   @default(false) @map("is_system")
  isTemplate     Boolean   @default(false) @map("is_template")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  organization   Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberRoles    OrganizationMemberRole[]
  permissions    RolePermission[]

  @@unique([organizationId, slug])
  @@map("roles")
  @@index([organizationId])
  @@index([slug])
  @@index([isSystem])
  @@index([isTemplate])
}

model OrganizationMemberRole {
  id                  String @id @default(uuid()) @db.Uuid
  organizationMemberId String @map("organization_member_id") @db.Uuid
  roleId              String @map("role_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")

  // Relations
  organizationMember OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)
  role              Role              @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([organizationMemberId, roleId])
  @@map("organization_member_roles")
  @@index([organizationMemberId])
  @@index([roleId])
}

// ============================================================================
// PERMISSIONS
// ============================================================================

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  scope       String   @default("ORGANIZATION") // GLOBAL, ORGANIZATION, RESOURCE, OWNED, ASSIGNED
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  roles RolePermission[]

  @@map("permissions")
  @@index([key])
  @@index([scope])
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
  @@index([roleId])
  @@index([permissionId])
}

// ============================================================================
// RESOURCE RELATIONSHIPS
// ============================================================================

model ResourceRelationship {
  id             String    @id @default(uuid()) @db.Uuid
  subjectType    String    @map("subject_type")
  subjectId      String    @map("subject_id") @db.Uuid
  relationship   String
  resourceType   String    @map("resource_type")
  resourceId     String    @map("resource_id") @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  metadata       Json?
  startsAt       DateTime? @map("starts_at")
  endsAt         DateTime? @map("ends_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("resource_relationships")
  @@index([subjectType, subjectId])
  @@index([resourceType, resourceId])
  @@index([organizationId])
  @@index([relationship])
  @@index([startsAt, endsAt])
}

// ============================================================================
// AUDIT LOGS
// ============================================================================

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  action         String
  resourceType   String?  @map("resource_type")
  resourceId     String?  @map("resource_id") @db.Uuid
  metadata       Json?
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  actorUser      User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
  @@index([actorUserId])
  @@index([organizationId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}
