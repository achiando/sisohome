{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "SESSION_SECRET",
    "TWO_FACTOR_ENCRYPTION_KEY",
    "FIELD_ENCRYPTION_KEY",
    "INTAKE_TOKEN_SECRET",
    "NODE_ENV",
    "DATABASE_URL",
    "APP_URL",
    "EMAIL_TRANSPORT",
    "EMAIL_FROM",
    "EMAIL_OUTBOX_DIR",
    "RESEND_API_KEY",
    "SMTP_URL",
    "CLOUDINARY_API_KEY",
    "CLOUDINARY_API_SECRET",
    "NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME",
    "ADMIN_EMAIL",
    "ADMIN_PASSWORD",
    "NEXT_PUBLIC_WHATSAPP_NUMBER",
    "NEXT_PUBLIC_SITE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:generate": {
      "dependsOn": ["^db:generate"],
      "inputs": ["prisma/schema.prisma", "prisma7.config.ts", ".env*"],
      "outputs": ["generated/prisma/**"],
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:seed": {
      "dependsOn": ["db:generate"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "ADMIN_EMAIL", "ADMIN_PASSWORD"]
    },
    "lint": {
      "dependsOn": ["^lint", "^db:generate"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "^db:generate"]
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DATABASE_URL"]
    }
  }
}
